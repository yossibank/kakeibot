    { "summary": "空白だけなら変えない", "recent": ["ランチ"], "text": "   ", "result": ["ランチ"] },
    { "summary": "5 つを超えたら古いものを消す", "recent": ["a", "b", "c", "d", "e"], "text": "f", "result": ["f", "a", "b", "c", "d"] },
    { "summary": "同じ言葉を重ねず先頭に移す", "recent": ["a", "b", "c", "d", "e"], "text": "c", "result": ["c", "a", "b", "d", "e"] }
